# FabInventory Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Generate a secure random key:
#   python3 -c 'import secrets; print(secrets.token_hex(32))'

# Required
SECRET_KEY=fabinventory-secret-key

# Data storage path
REPO_PATH=./fabinventory_data

# Local admin password (used when GitHub OAuth is not configured)
ADMIN_PASSWORD=fabinventory

# GitHub OAuth (optional — set both to enable GitHub login)
# Create an OAuth app at: https://github.com/settings/developers
#   Homepage URL: http://localhost:9000
#   Authorization callback URL: http://localhost:9000/login/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
